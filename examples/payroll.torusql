-- TorusSQL example: encrypted payroll
-- Start a server first (torusdb-server), then run from the repository root:
--     torussql -f examples/payroll.torusql
-- The file creates table `payroll`; to run it again use a fresh server (or `DROP TABLE payroll;`).
-- Pass --vault PATH if you want to read the encrypted data again from a later session.
--
-- Every value in `rate`/`hours`/`overtime`/`tax`/`salary` stays encrypted on the server.
-- Every intermediate below (a sum, a product, a quotient) is a two-party additive sharing: the server
-- holds its share, you (the owner) hold the other, and nobody unmasks an operand. One
-- request/response per multiplicative level; the server only ever sends back its share of the final
-- result. Add --authenticated if you do not trust the server to follow the protocol.
-- See spec v0.6 section 5.10 and docs/crypto-review-packet.md section 3.3.

CREATE TABLE payroll (
    id       INT      PLAIN,
    rate     INT      PAIRED,
    hours    INT      PAIRED,
    overtime INT      PAIRED,
    tax      RATIONAL PAIRED,
    salary   RATIONAL PAIRED       -- PAIRED works wherever ENC does, and also in products/quotients
);

INSERT INTO payroll (id, rate, hours, overtime, tax, salary) VALUES (1, 50, 40, 5, FRAC(1,5), FRAC(8000,1));
INSERT INTO payroll (id, rate, hours, overtime, tax, salary) VALUES (2, 60, 35, 2, FRAC(1,4), FRAC(9000,1));
INSERT INTO payroll (id, rate, hours, overtime, tax, salary) VALUES (3, 45, 40, 4, FRAC(1,5), FRAC(7000,1));

-- Encrypted aggregation: total payroll, never decrypted server-side.
SELECT SUM(salary) FROM payroll;                                  -- 24000

-- Public scalar x encrypted column, per row: each salary times 12
-- -> [96000, 108000, 84000]  (use `12 * SUM(salary)` for the scaled total, 288000).
SELECT 12 * salary FROM payroll;

-- Encrypted x encrypted, per row (depth 1): each person's gross pay -> [2000, 2100, 1800].
SELECT id, rate * hours FROM payroll;

-- Encrypted inner product (INT PAIRED): total gross across everyone,
-- = 50*40 + 60*35 + 45*40 = 2000 + 2100 + 1800 = 5900, computed in one step.
SELECT DOT(rate, hours) FROM payroll;

-- ---- dialect v0.6: expressions --------------------------------------------------------------

-- Mixed + - * with a public fraction: pay with overtime at 1.5x (depth 1: one round)
-- -> [2375, 2280, 2070]
SELECT rate * (hours + overtime * FRAC(3,2)) FROM payroll;

-- Chained multiplication, depth 2 (two rounds): net pay after tax
-- gross * (1 - tax) -> [1600, 1575, 1440]
SELECT rate * hours * (1 - tax) FROM payroll;

-- Depth 3 (three rounds): net pay times overtime hours -> [8000, 3150, 5760]
SELECT rate * hours * (1 - tax) * overtime FROM payroll;

-- Aggregate of a chained product: total net pay = 4615
SELECT SUM(rate * hours * (1 - tax)) FROM payroll;

-- Division by a public constant: monthly salary, exact rationals -> [2000/3, 750, 1750/3]
SELECT salary / 12 FROM payroll;

-- Division by an ENCRYPTED value (never decrypted: only a uniform masked product is opened): salary per hour
-- -> [200, 1800/7, 175].  A zero denominator is an error, never a wrong number.
SELECT salary / hours FROM payroll;

-- Aggregate division: mean gross pay = 5900/3 ; salary per hour overall = 4800/23
SELECT SUM(rate * hours) / COUNT(*), SUM(salary) / SUM(hours) FROM payroll;

-- Everything together, with an alias: gross + monthly salary - overtime
-- -> [2000 + 2000/3 - 5, 2100 + 750 - 2, 1800 + 1750/3 - 4]
SELECT rate * hours + salary / 12 - overtime AS total FROM payroll;

-- ---- FHE columns (dialect v0.6.2): the server itself adds / multiplies ciphertexts, no key -------
-- `FHE` is the OTHER mode (complementary to ENC/PAIRED above): no mask vault, no per-cell owner
-- state, any number of clients may share one key. Reading/writing FHE cells needs a key the rest of
-- this file does not: create one once (`torussql --fhe-keygen ./fhe.key --fhe-pass-env FHE_PASS`) and
-- pass `--fhe-key ./fhe.key --fhe-pass-env FHE_PASS` to `torussql` for the statements below.
-- See docs/fhe-columns.md "Expressions over FHE columns".

CREATE TABLE fhe_payroll (
    id    INT PLAIN,
    rate  INT FHE,
    hours INT FHE
);
INSERT INTO fhe_payroll (id, rate, hours) VALUES (1, 50, 40);
INSERT INTO fhe_payroll (id, rate, hours) VALUES (2, 60, 35);
INSERT INTO fhe_payroll (id, rate, hours) VALUES (3, 45, 40);

-- Encrypted sum, server adds ciphertexts (EC point addition): total base rate = 155
SELECT SUM(rate) FROM fhe_payroll;

-- Encrypted inner product (DOT, a pairing): total gross across everyone
-- = 50*40 + 60*35 + 45*40 = 5900, computed server-side from ciphertexts only.
SELECT DOT(rate, hours) FROM fhe_payroll;

-- v0.6.2: the SAME per-row product, UN-aggregated -- one ciphertext per row, the server pairs each
-- row on its own (not summed), the owner decrypts each individually -> [2000, 2100, 1800].
SELECT rate * hours FROM fhe_payroll;

-- v0.6.2: SUM(x*y) of two bare FHE columns now gives the same answer as DOT(x, y) -- 5900,
-- through the identical server-side pairing path (DOT keeps working unchanged).
SELECT SUM(rate * hours) FROM fhe_payroll;
